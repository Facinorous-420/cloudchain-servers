# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# prisma generated client
/src/generated

# playwright
/playwright-report/
/test-results/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets stay local; the example template is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local state
.claude/
CLAUDE.md

# user-uploaded images — stored on disk via the /api/upload route. The
# uploads/ folder ships with a .gitkeep so the path exists in fresh
# clones; the actual images are local to each environment.
/public/uploads/*
!/public/uploads/.gitkeep
