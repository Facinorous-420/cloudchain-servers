# Copy this file to .env and adjust values for your environment.

# PostgreSQL connection string.
# For local dev against the docker-compose `db` service, host is localhost.
# Inside docker-compose the `app` service overrides this with host `db`.
DATABASE_URL="postgresql://cloudchain:cloudchain@localhost:5432/cloudchain?schema=public"

# Auth.js (NextAuth v5).
# Generate a real secret with: npx auth secret
AUTH_SECRET="replace-with-a-generated-secret"
# Trust the request host (needed off Vercel — LAN / Docker deployments).
AUTH_TRUST_HOST="true"

# Default admin user created by the seed (prisma/seed.ts).
# Change the password after first login.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="changeme"

# --- Production-only (docker-compose.prod.yml reads these) -------------
# Postgres container credentials. POSTGRES_PASSWORD has no default — set
# it before bringing up the stack.
POSTGRES_USER="cloudchain"
POSTGRES_PASSWORD="set-a-strong-password"
POSTGRES_DB="cloudchain"
